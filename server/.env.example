# ================================================================
# SupplierQuoteCompare — Backend Environment Configuration
# ================================================================

# Server Port (Render sets this dynamically in production)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# MongoDB Atlas Remote Connection String
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Add a Database User and whitelist IP 0.0.0.0/0
# 3. Replace <username> and <password> below with your credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/supplierquotecompare?retryWrites=true&w=majority

# Client Application URL for CORS whitelist (your deployed frontend URL on Render)
CLIENT_URL=https://supplierquotecompare.onrender.com
